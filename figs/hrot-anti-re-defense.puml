@startuml
left to right direction
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans CJK TC"
skinparam dpi 150
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam ArrowColor #1E293B
skinparam ArrowFontColor #0F172A
skinparam ArrowFontSize 11

title Hardware Root of Trust（HRoT）防逆向工程五層縱深防禦模型

package "攻擊者逆向工程路徑（Attack Vectors）" #FEF2F2 {
  rectangle "① 拆 Flash 晶片 dump 韌體反組譯（靜態逆向）" as A1 #FECACA
  rectangle "② 接 JTAG / SWD 單步除錯讀 RAM（動態逆向）" as A2 #FECACA
  rectangle "③ 竄改 Bootloader 植入傾印程式（程式注入）" as A3 #FECACA
  rectangle "④ 刷回舊版韌體利用已知漏洞（降級攻擊）" as A4 #FECACA
  rectangle "⑤ 從 Linux / DMA 跨界偷讀安全區（越權竊取）" as A5 #FECACA
}

package "HRoT 硬體信任根防線（Mask ROM + eFuse/OTP + HUK）" #EFF6FF {
  rectangle "防線 1：韌體／TA 加密（Encrypted Boot + HUK / PUF）\nAES-256-GCM 密文落地，金鑰鎖死硬體 [本環境已實測]" as D1 #DCFCE7
  rectangle "防線 2：硬體 Debug 鎖死（eFuse 關閉 JTAG / SPIDEN）\n僅原廠私鑰簽章且綁定 UID 的 Debug Token 可解鎖" as D2 #BFDBFE
  rectangle "防線 3：安全開機驗簽（BL1 ROTPK + U-Boot Signed FIT）\nTBBR + FIT 全鏈驗簽，改 1 bit 即拒載 [本環境已實測]" as D3 #DCFCE7
  rectangle "防線 4：硬體防降級（OTP 單調遞增 NV Counter）\nTFW / NTFW 雙軌防降級與升級燒錄 [本環境已實測]" as D4 #DCFCE7
  rectangle "防線 5：硬體記憶體隔離（TrustZone TZC-400 / 防火牆）\n匯流排層阻絕 Normal World CPU 與非安全 DMA" as D5 #BFDBFE
}

A5 -[hidden]right-> A4
A4 -[hidden]right-> A3
A3 -[hidden]right-> A2
A2 -[hidden]right-> A1

D5 -[hidden]right-> D4
D4 -[hidden]right-> D3
D3 -[hidden]right-> D2
D2 -[hidden]right-> D1

A1 --> D1 : "阻斷"
A2 --> D2 : "阻斷"
A3 --> D3 : "阻斷"
A4 --> D4 : "阻斷"
A5 --> D5 : "阻斷"

legend bottom
  <b>本 QEMU 環境對應狀態（2026-11-28 全四條研究路線已完成實測）</b>
  • 綠色（防線 1 / 3 / 4）：TF-A AES-GCM 韌體加密、OP-TEE 加密 TA 與 Secure Storage、TBBR + U-Boot Signed FIT、雙軌 OTP 防降級均已實測驗證
  • 藍色（防線 2 / 5 / 抗 Glitch 與側通道 SCA）：需真實量產 SoC 搭配 eFuse JTAG Lock、TZC-400 與物理感測器
endlegend

@enduml
