@startuml
skinparam dpi 150
skinparam defaultFontName "Noto Sans CJK TC"
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle

title Linux + OP-TEE 4.1.0 實機驗證通道與測試項目總覽

package "Normal World (Linux 6.6.160, NS-EL0 / NS-EL1)" #EBF5FB {
  rectangle "optee_example_hello_world\n• 送入 42 → TA 遞增 → 回傳 43" as hello #D6EAF8
  rectangle "xtest -t regression 1001..1008\n• 8 test cases / 120 subtests (0 failed)\n• 含 1008.4 Load corrupt TA OK" as xtest #D6EAF8
  rectangle "tee-supplicant (背景守護行程)\n• 協助 OP-TEE 讀取 /lib/optee_armtz/*.ta\n• 提供安全儲存 / RPMB 轉發" as supp #AED6F1
  rectangle "Linux Kernel Driver\n• optee: revision 4.1 (18b424c2)\n• dynamic shared memory enabled\n• /dev/tee0, /dev/teepriv0, tpm0" as kdrv #85C1E9
}

rectangle "EL3：TF-A BL31 (v2.10.4, SPD=opteed)\nSMC Calling Convention v1.4 世界切換路由" as bl31 #FCF3CF

package "Secure World (OP-TEE OS 4.1.0, S-EL1 / S-EL0)" #FDEDEC {
  rectangle "OP-TEE Core (S-EL1, 0x0e100000..0x0effffff)\n• TA 簽章驗證 (攔截損毀 TA)\n• 共享記憶體管理 (0x42000000..0x421fffff)" as optee #F5B7B1
  rectangle "User TAs (S-EL0)\n• Hello World TA\n• xtest Crypt / OS / Panic / Client TAs" as uta #FADBD8
  rectangle "Early TA (內嵌於 BL32)\n• optee-ftpm (UUID: bc50d971-...)" as ftpm #FADBD8
}

hello -down-> kdrv : /dev/tee0
xtest -down-> kdrv : /dev/tee0
supp -down-> kdrv : /dev/teepriv0
kdrv -down-> bl31 : SMC 呼叫
bl31 -down-> optee : 進入 Secure World
optee -down-> uta : 驗簽並執行 User TA
optee -down-> ftpm : 執行 fTPM Early TA

@enduml
